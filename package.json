{
  "name": "villa-portfolio",
  "private": true,
  "description": "Portfolio site: a desert villa built in Blender and shown with three.js",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "assets": "python blender/fetch_assets.py",
    "scene": "node tools/blender.mjs build_scene",
    "bake": "node tools/blender.mjs bake_lightmaps",
    "bake:draft": "node tools/blender.mjs bake_lightmaps --draft",
    "export": "node tools/blender.mjs export_web",
    "figure": "node tools/blender.mjs export_figure",
    "previews": "node tools/blender.mjs render_previews",
    "previews:draft": "node tools/blender.mjs render_previews --draft",
    "build": "npm run scene && npm run bake && npm run export",
    "serve": "python tools/serve.py",
    "moodboard": "node tools/blender.mjs moodboard",
    "resume:pdf": "node tools/resume_pdf.mjs"
  }
}
