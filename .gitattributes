# Text files are stored with LF line endings.
* text=auto eol=lf

# Binary assets must never have line endings touched. The .hdr sky files in
# particular start with a text header, so Git could mistake them for text.
*.hdr  binary
*.ktx2 binary
*.glb  binary
*.jpg  binary
*.png  binary
*.npy  binary
*.npz  binary
*.blend binary
